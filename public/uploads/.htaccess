# =========================================
# Secure uploads directory
# Granules India
# =========================================

# Disable directory browsing
Options -Indexes

# Block execution of server-side scripts
<FilesMatch "\.(php|php5|phtml|phar|cgi|pl|py|sh|exe|asp|aspx)$">
    Require all denied
</FilesMatch>

# Prevent access to hidden files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block potentially dangerous config/system files
<FilesMatch "\.(htaccess|htpasswd|ini|log|conf)$">
    Require all denied
</FilesMatch>

# Allow normal WordPress media/uploads
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|pdf|doc|docx|xls|xlsx|ppt|pptx|mp4|webm|mp3|wav|css|js|html|htm)$">
    Require all granted
</FilesMatch>